# Keep the build context tiny and secret-free. Stage 2 copies only api/, src/,
# requirements-api.lock; stage 1 copies web/ (minus the ignores below).
.git
.venv
**/node_modules
# dist is built in-stage (stage 1) — never taken from the host:
web/dist
# Test output and the TypeScript build cache churn the COPY cache key and are
# never part of the bundle (launch-1, item 4 verify):
web/test-results
web/playwright-report
web/*.tsbuildinfo
# Never ship a stale local DB — the container bootstraps from data-latest:
data/*.db*
data
# Secrets never enter the context:
**/.env*
.streamlit
**/__pycache__
*.pyc
logs
output
proposals
docs
notebooks
tests
.github
.claude
scripts
*.md
