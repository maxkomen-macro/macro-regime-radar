# web/.env.example — what the Vercel project sets for the static site.
# Copy to .env.local for a local split-origin run; Vercel takes them from the
# project's Environment Variables. Only VITE_-prefixed values reach the bundle.

# The API host, with scheme and no trailing slash. Empty (the default) means
# same origin, which is the single-service deploy.
VITE_API_BASE=https://your-api-host.example

# The relay socket. Optional: with VITE_API_BASE set and no VITE_WS_BASE, the
# client derives wss:// from it. Set it when the socket lives elsewhere.
VITE_WS_BASE=wss://your-api-host.example

# Where the validated snapshot is fetched from at first paint. The default
# below is the copy the build downloads into public/snapshot/.
VITE_SNAPSHOT_URL=/snapshot/latest.json

# Read by the Vercel build command (scripts/fetch-snapshot.mjs), not by the
# bundle: a fine-grained GitHub token with Contents: Read on this private repo,
# used to download snapshot-latest.json from the data-latest release.
GH_SNAPSHOT_TOKEN=
