# deploy/api.env.example — every environment variable the API reads, with the
# value a public 24/7 deploy uses. Copy the entries into the host's secret
# store (Render: Environment; Fly: fly secrets set; Railway: Variables).
# Never commit a filled copy: this file holds names and defaults only.
#
# Grouped as: what the deploy must set, what it should set, and what it can
# leave alone. The API reads nothing else; the static site's variables live in
# web/.env.example.

# ── Must set ────────────────────────────────────────────────────────────────

# This process serves the internet. It turns the posture on by itself: the
# assistant stops defaulting open and the diagnostics endpoints fail closed
# without an ops key. Set it even when CORS_ORIGINS is set; set it especially
# in the single-service deploy, which sets no CORS_ORIGINS at all.
DEPLOY_PUBLIC=1

# The static site's origin, comma-separated for more than one. Replaces the
# Vite dev defaults and is what the relay socket's Origin allowlist checks.
CORS_ORIGINS=https://your-site.vercel.app

# Live quotes, on-demand lookups and the market prefetch. Without it the feeds
# stay off and lookups answer a typed "missing token" error. One process per
# token: its 50 live symbols are shared across every connection, so a second
# API (or a local dev server) on the same token starves this one.
EODHD_API_TOKEN=

# Read-only, fine-grained GitHub PAT (Contents: Read on this repo). The API
# downloads the validated database from the data-latest release at start and
# whenever its identity changes.
GH_DB_TOKEN=

# Opens the two diagnostics views with an X-Ops-Key header. With DEPLOY_PUBLIC
# set and no key, they answer 503 rather than serving relay and plan internals.
OPS_ACCESS_KEY=

# How the assistant is served. This deploy runs it open to the public, under a
# hard daily spend ceiling; `key` requires ASSISTANT_ACCESS_KEY, `off` disables
# it. Set it explicitly rather than relying on the posture default.
ASSISTANT_ACCESS=open

# The assistant's model key. Without it the analyst answers that it is not
# configured; every other screen is unaffected.
ANTHROPIC_API_KEY=

# Company fundamentals for the single-name panel (free tier, US listings).
# Without it the panel shows price and history and says fundamentals are
# unavailable.
FINNHUB_API_KEY=

# ── Should set ──────────────────────────────────────────────────────────────

# Minutes between checks of the data-latest release asset. It downloads only
# when the asset's identity changed, so 10 is cheap and keeps the site at most
# ten minutes behind a published refresh.
BOOTSTRAP_DB_REFRESH_MIN=10

# How many reverse proxies in front of this process append X-Forwarded-For.
# Render, Fly and Railway each put exactly one in front. With 0 (the default)
# every visitor behind the proxy shares one rate-limit bucket.
TRUSTED_PROXY_HOPS=1

# The assistant's ceiling, in US dollars of recorded spend per UTC day. When
# the day is spent the chip says the analyst is resting until tomorrow.
ASSISTANT_DAILY_CAP_USD=1.0

# ── Can stay unset (defaults shown) ─────────────────────────────────────────

# ASSISTANT_ACCESS_KEY=            # required only when ASSISTANT_ACCESS=key
# ASSISTANT_MAX_CONCURRENCY=4      # answers in flight before a 429
# ASSISTANT_LEDGER_PATH=/app/data/assistant_spend.db  # the daily spend ledger
# CSP_CONNECT_SRC=                 # extra connect-src origins for a shell this
#                                  # process serves itself (single-service only)
# PREFETCH_MARKET=1                # keep the strip's candles warm in session
# GC_FREEZE=1                      # freeze the heap after the first build
# EODHD_PROBE_ON_START=1           # one entitlement probe per family at start
# PROVIDER_MAX_CONCURRENCY=8       # upstream provider calls in flight
# DB_MAX_CONCURRENCY=24            # stored reads in flight
# RATE_LIMIT_PER_CLIENT_PER_MIN=600
# RATE_LIMIT_PER_CLIENT_BURST=120
# RATE_LIMIT_GLOBAL_PER_MIN=4000
# RATE_LIMIT_GLOBAL_BURST=600
# WS_MAX_PER_CLIENT=20             # relay sockets per client id
# WS_MAX_TOTAL=200                 # relay sockets in total
# MAX_BODY_BYTES=65536             # request body cap (the assistant's is 16 KB)
# BOOTSTRAP_DB_MAX_AGE_MIN=        # legacy: reported, decides nothing
# WORKER_WAIT_S=5                  # test harness only; production waits 5 s
# PORT=8000                        # hosts that assign a port set this themselves
#
# Read by uvicorn rather than by this code, and deliberately not set:
# WEB_CONCURRENCY would start a second worker, and with it a second EODHD relay
# on one token. The image pins --workers 1 so it cannot.
